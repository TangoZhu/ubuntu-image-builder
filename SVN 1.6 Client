name: Build Guaranteed Static SVN 1.6 Client

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build-static-svn:
    runs-on: ubuntu-latest

    steps:
      - name: Build SVN 1.6 statically inside Debian Squeeze Container
        run: |
          docker run --rm -v $(pwd):/workspace -w /workspace debian:squeeze-slim bash -c "
            set -e

            # 1. 切换 Debian Archive 源并安装完整静态库 (-dev)
            echo 'deb http://archive.debian.org/debian/ squeeze main' > /etc/apt/sources.list
            apt-get update -o Acquire::Check-Valid-Until=false
            apt-get install -y --force-yes build-essential wget \
                libapr1-dev libaprutil1-dev libneon27-dev zlib1g-dev \
                libssl-dev libkrb5-dev file

            # 2. 下载并解压 SVN 1.6.23 源码
            SVN_VER='1.6.23'
            wget --no-check-certificate https://archive.apache.org/dist/subversion/subversion-\${SVN_VER}.tar.bz2
            tar -xjf subversion-\${SVN_VER}.tar.bz2
            cd subversion-\${SVN_VER}

            # 3. 正确指定静态链接标志，并显式补全底层 C 库依赖 (-ldl -lpthread -lssl -lcrypto)
            ./configure \
                --enable-static \
                --disable-shared \
                --with-apr=/usr/bin/apr-1-config \
                --with-apr-util=/usr/bin/apu-1-config \
                --with-neon=/usr \
                --with-zlib \
                --without-berkeley-db \
                --without-serf \
                LIBS='-ldl -lpthread -lssl -lcrypto -lz' \
                LDFLAGS='-static'

            # 4. 编译客户端单文件，强制使用 -all-static
            make subversion/svn/svn LDFLAGS='-all-static -static'

            # 5. 提取并瘦身产物
            cp subversion/svn/svn /workspace/svn16-static
            strip /workspace/svn16-static

            # 6. 验证：必须包含 'statically linked' 且没有动态库依赖
            echo '==================== 编译结果验证 ===================='
            file /workspace/svn16-static
          "

      - name: Upload Binary Artifact
        uses: actions/upload-artifact@v4
        with:
          name: svn16-static-x86_64
          path: svn16-static
          retention-days: 7
